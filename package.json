{
  "name": "git-status-monitor",
  "version": "1.30.3",
  "description": "GitFinder - 智能Git项目管理器",
  "main": "main.js",
  "productName": "GitFinder",
  "bin": {
    "git-monitor": "./cli.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "npm test && node test/check-syntax.js",
    "start": "node server.js",
    "dev": "node server.js",
    "cli": "node cli.js",
    "scan": "node cli.js scan",
    "status": "node cli.js status",
    "verify:git-batch": "node scripts/verify-git-batch-performance.js",
    "verify:icons": "node scripts/verify-icon-assets.js",
    "verify:release-source": "node scripts/verify-release.js --phase source --mode development",
    "verify:release": "node scripts/verify-release.js --phase artifact --mode development --report dist/release-verification.json",
    "verify:windows-runtime": "electron scripts/verify-windows-runtime.js",
    "electron": "electron .",
    "pack": "bash scripts/build-mac.sh",
    "dist": "bash scripts/build-mac.sh",
    "pack:win": "node scripts/build-win.js"
  },
  "build": {
    "appId": "com.gitfinder.app",
    "productName": "GitFinder",
    "directories": {
      "output": "dist",
      "app": "."
    },
    "asar": true,
    "asarUnpack": [
      "public/**/*"
    ],
    "files": [
      "main.js",
      "server.js",
      "cli.js",
      "preload.js",
      "public/**/*",
      "src/**/*",
      "node_modules/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "goldf2",
      "repo": "git-status-monitor"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "artifactName": "${productName}-${version}-${arch}-win.${ext}"
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-win-setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GitFinder",
      "uninstallDisplayName": "GitFinder ${version}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^42.10.1",
    "electron-builder": "^26.15.3"
  },
  "keywords": [
    "git",
    "monitor",
    "status",
    "dashboard"
  ],
  "author": "goldf2",
  "license": "MIT"
}
